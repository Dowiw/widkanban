# WidKanban Developer Environment Credentials
# Copy this file to .env or .env.local and fill in your developer test tokens.
# These variables are only loaded locally in development mode by the native Rust backend.

# GitHub Personal Access Token (PAT) with repo scope
GITHUB_TOKEN=ghp_yourTestGithubTokenHere

# Google Tasks OAuth 2.0 Access Token (e.g. from Google OAuth Playground)
GOOGLE_TASKS_TOKEN=ya29.yourTestGoogleTasksAccessTokenHere

# Future Microsoft 365 / Graph Token (Optional)
# MICROSOFT_TOKEN=
